{
  "name": "gambito-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "test:engine": "npm test --workspace=@gambito/engine",
    "dev": "npm run dev --workspace=@gambito/web",
    "build": "npm run build --workspace=@gambito/web",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
